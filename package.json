{
  "name": "dsh-approval-translator",
  "version": "1.0.0",
  "description": "Adds an \"Explain this action\" button under the DeepSeek Harness permission approval card: one click spells out, in plain language, what the action does, which files it touches, whether it changes or deletes anything, what the privacy risk is, and whether to allow it.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "approval",
    "permission",
    "explain",
    "plain-language",
    "accessibility"
  ],
  "license": "MIT",
  "author": "zhaoqiminggg",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/preview.svg",
    "scripts/*.mjs",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node scripts/smoke-host.mjs && node scripts/smoke-client.mjs",
    "check": "node --check index.js && node --check client.js && node -e \"JSON.parse(require('node:fs').readFileSync('package.json','utf8'));JSON.parse(require('node:fs').readFileSync('locale/zh.json','utf8'));JSON.parse(require('node:fs').readFileSync('locale/en.json','utf8'))\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhaoqiminggg/dsh-approval-translator.git"
  },
  "bugs": {
    "url": "https://github.com/zhaoqiminggg/dsh-approval-translator/issues"
  },
  "homepage": "https://github.com/zhaoqiminggg/dsh-approval-translator#readme",
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-approval",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
